# Copie ce fichier en ".env" et remplis les valeurs avant de lancer le site

# --- Base de donnees (Supabase) ---
# Sans cette variable, le site tourne en local avec un fichier db/data.json (pratique pour tester,
# mais perdu a chaque redeploiement sur la plupart des hebergeurs). Avec DATABASE_URL renseignee,
# tout (produits, commandes, comptes, points de fidelite) est stocke dans Postgres/Supabase et survit
# aux redeploiements.
# Ou la trouver : sur https://supabase.com -> ton projet -> Project Settings -> Database ->
# Connection string -> onglet "Transaction" (port 6543, adapte aux hebergeurs comme Render/Railway).
# Avant le premier lancement, execute le contenu de db/schema.sql dans Supabase -> SQL Editor -> New query -> Run.
DATABASE_URL=

# --- Photos produits (Supabase Storage) ---
# Sans ces deux variables, les photos uploadees depuis l'admin sont ecrites dans /uploads (disque
# local) : pratique en dev, mais perdu au redeploiement sur la plupart des hebergeurs, exactement
# comme pour DATABASE_URL ci-dessus. Avec ces variables renseignees, les photos sont envoyees dans
# Supabase Storage et restent accessibles apres chaque redeploiement.
# Ou les trouver : Supabase -> ton projet -> Project Settings -> API -> "Project URL" (SUPABASE_URL)
# et "service_role" secret key (SUPABASE_SERVICE_ROLE_KEY, PAS la cle "anon").
# Avant le premier upload, cree le bucket une seule fois : Supabase -> Storage -> New bucket ->
# nom "product-images" -> active "Public bucket".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe pour te connecter à /admin (choisis quelque chose de solide)
ADMIN_PASSWORD=change-moi

# Clé secrète pour chiffrer les sessions (une longue chaine aleatoire quelconque)
SESSION_SECRET=change-moi-aussi-une-longue-chaine-aleatoire

# Identifiants PayPal (a recuperer sur https://developer.paypal.com -> My Apps & Credentials)
# Commence en "sandbox" pour tester sans vrai argent, puis passe en "live" quand tu es prete
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=ton-client-id-paypal
PAYPAL_CLIENT_SECRET=ton-client-secret-paypal

# Devise utilisee pour les prix
CURRENCY=EUR

# Port du serveur (Render/Railway le definissent automatiquement, sinon 3000 en local)
PORT=3000

# --- Optionnel : email de confirmation automatique apres achat ---
# Cree un compte gratuit sur https://resend.com, recupere une cle API,
# et verifie un domaine (ou utilise l'adresse de test fournie par Resend).
# Si tu laisses ces valeurs vides, le site fonctionne normalement, juste sans email envoye.
RESEND_API_KEY=
RESEND_FROM=Aube <onboarding@resend.dev>

# URL publique de ton site une fois deployee (utilisee dans le lien de l'email de confirmation)
PUBLIC_URL=https://ton-site.onrender.com

# Le site demarre TOUJOURS en "mode test" (commande sans paiement reel), meme si
# les identifiants PayPal ci-dessus sont renseignes : il faut en plus activer les
# paiements depuis l'admin -> Reglages -> "Activer les paiements PayPal" pour que
# le vrai paiement PayPal prenne le relais. Ca evite un site bloque sur "paiement
# indisponible" si les identifiants PayPal sont incomplets ou invalides.
